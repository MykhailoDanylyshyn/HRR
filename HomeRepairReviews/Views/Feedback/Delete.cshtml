@model HomeRepairReviews.Models.Feedback

@{
    ViewBag.Title = "Видалення відгуку";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">

        <div class="card shadow-sm border-0">
            <div class="card-body p-4 text-center">

                <h2 class="mb-3">Видалити відгук?</h2>

                <p class="text-muted mb-4">
                    Ви дійсно хочете видалити цей відгук?
                </p>

                <div class="border rounded p-3 mb-4 text-start">
                    <div class="mb-2">
                        <strong>Користувач:</strong>
                        @Model.UserName
                    </div>

                    <div class="mb-2">
                        <strong>Дата:</strong>
                        @Model.Date.ToString("dd.MM.yyyy")
                    </div>

                    <div>
                        <strong>Відгук:</strong>
                        <div class="mt-2">
                            @Model.Text
                        </div>
                    </div>
                </div>

                <form asp-action="Delete"
                      method="post">

                    <input type="hidden"
                           asp-for="Id" />

                    <div class="d-flex justify-content-center gap-2">

                        <button type="submit"
                                class="btn btn-danger">
                            Видалити
                        </button>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-secondary">
                            Скасувати
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>
