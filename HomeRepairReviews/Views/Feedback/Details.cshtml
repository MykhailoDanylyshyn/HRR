@model HomeRepairReviews.Models.Feedback

@{
    ViewBag.Title = "Подробиці відгуку";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-9 col-lg-8">

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">

                <div class="d-flex justify-content-between mb-3">
                    <strong>@Model.UserName</strong>

                    <span>
                        @Model.Date.ToString("dd.MM.yyyy")
                    </span>
                </div>

                <div class="mb-3">
                    <strong>Майстер:</strong>
                    @Model.Master
                </div>

                <div class="mb-4">
                    <strong>Вид робіт:</strong>
                    @Model.WorkType
                </div>

                <h3 class="mb-3">
                    Відгук
                </h3>

                <p class="mb-4">
                    @Model.Text
                </p>

                @if (Model.Photos.Any())
                {
                    <h4 class="mb-3">
                        Фото ремонту
                    </h4>

                    <div class="d-flex flex-wrap gap-3">

                        @foreach (var photo in Model.Photos)
                        {
                            <img src="@photo.PhotoPath"
                                 class="details-photo"
                                 alt="Фото ремонту"
                                 onclick="openPhoto('@photo.PhotoPath')" />
                        }

                    </div>
                }

                <div class="mt-4">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Назад
                    </a>

                </div>

            </div>
        </div>

    </div>
</div>


<!-- Велике фото -->

<div id="photoModal"
     onclick="closePhoto()"
     style="display:none;
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background:rgba(0,0,0,0.85);
    z-index:2000;
    align-items:center;
    justify-content:center;">

    <!-- Закрити -->

    <span onclick="closePhoto()"
          style="position:absolute;
        top:20px;
        right:35px;
        color:white;
        font-size:40px;
        cursor:pointer;">
        ×
    </span>


    <!-- Ліва стрілка -->

    <button onclick="previousPhoto(event)"
            style="position:absolute;
        left:30px;
        top:50%;
        transform:translateY(-50%);
        background:none;
        border:none;
        color:white;
        font-size:50px;
        cursor:pointer;">
        ‹
    </button>


    <!-- Фото -->

    <img id="bigPhoto"
         onclick="event.stopPropagation()"
         style="max-width:80%;
    max-height:90%;
    object-fit:contain;
    border-radius:8px;" />


    <!-- Права стрілка -->

    <button onclick="nextPhoto(event)"
            style="position:absolute;
        right:30px;
        top:50%;
        transform:translateY(-50%);
        background:none;
        border:none;
        color:white;
        font-size:50px;
        cursor:pointer;">
        ›
    </button>

</div>


@section Scripts {

    <script>

        const photos = [
                    @foreach (var photo in Model.Photos)
            {
                @: "@photo.PhotoPath",
            }
                ];

        let currentPhoto = 0;


        function openPhoto(photoPath) {

            currentPhoto = photos.indexOf(photoPath);

            document.getElementById("bigPhoto").src = photos[currentPhoto];

            document.getElementById("photoModal").style.display = "flex";
        }


        function closePhoto() {

            document.getElementById("photoModal").style.display = "none";
        }


        function previousPhoto(event) {

            event.stopPropagation();

            currentPhoto--;

            if (currentPhoto < 0) {
                currentPhoto = photos.length - 1;
            }

            document.getElementById("bigPhoto").src = photos[currentPhoto];
        }


        function nextPhoto(event) {

            event.stopPropagation();

            currentPhoto++;

            if (currentPhoto >= photos.length) {
                currentPhoto = 0;
            }

            document.getElementById("bigPhoto").src = photos[currentPhoto];
        }


        document.addEventListener("keydown", function(event) {

            if (document.getElementById("photoModal").style.display !== "flex")
                return;

            if (event.key === "ArrowLeft") {
                previousPhoto(event);
            }

            if (event.key === "ArrowRight") {
                nextPhoto(event);
            }

            if (event.key === "Escape") {
                closePhoto();
            }

        });

    </script>

}
